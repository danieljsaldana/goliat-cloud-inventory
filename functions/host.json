{
  "version": "2.0",
  "functionTimeout": "00:15:00",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:05:00",
      "messageEncoding": "base64"
    }
  },
  "logging": { "logLevel": { "default": "Warning", "Function": "Information" } }
}
