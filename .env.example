# Web
PORT=4000
SITE_URL=http://127.0.0.1:4000/
# Tiempo máximo de actualización desde Azure Blob Storage en ms (máx. 900000).
INVENTORY_REFRESH_TIMEOUT_MS=120000
# Etiquetas para la recogida local de Functions, separadas por comas; vacío detecta todas.
# En Azure se guardan desde Administración; no se envía este .env al despliegue.
INVENTORY_TAG_KEYS=Environment,Project,Tier

# Logs: true | false; nivel info | warn | error; peticiones HTTP true | false.
LOG_ENABLED=true
LOG_LEVEL=info
LOG_HTTP_ENABLED=true

# Login: true | false; modo demo | azure-ad.
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_AUTH_MODE=demo
# Secreto de sesión: mínimo 32 bytes.
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:4000
# Credenciales del modo demo.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Credenciales del modo azure-ad.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
# Administradores de Goliat: IDs de objeto del tenant separados por comas. Solo modo azure-ad.
DASHBOARD_ADMIN_OBJECT_IDS=
# Miembros: requiere modo azure-ad, tablas de db:init y User.Read.All en la identidad web.
# iac/configure-members.ps1 prepara el acceso de lectura al directorio.
DASHBOARD_MEMBERS_ENABLED=false

# PostgreSQL genérico: local, autogestionado o administrado
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cloud_inventory
DB_USER=cloud_inventory
DB_PASSWORD=
DB_POOL_SIZE=5
DB_QUERY_TIMEOUT_MS=60000
DB_APPLICATION_NAME=goliat-cloud-inventory

# Migraciones: credenciales opcionales; vacío reutiliza DB_*.
DB_MIGRATION_HOST=
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
DB_MIGRATION_LOCK_TIMEOUT_MS=5000
DB_MIGRATION_STATEMENT_TIMEOUT_MS=900000
# TLS: true | false. En local sin TLS usar false.
# CA opcional: vacío usa las CA del sistema; indicar PEM si el servidor requiere otra CA.
DB_SSL=true
DB_SSL_CA_PATH=

# Azure Storage: default | client-secret | managed-identity.
AZURE_AUTH_MODE=client-secret
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Blob de inventario Azure (límite en MiB).
AZURE_FUNCTION_BASE_URL=https://your-function.azurewebsites.net
# Recurso fijo para Administración; la identidad web requiere el rol de iac/administration.bicep.
AZURE_FUNCTION_RESOURCE_ID=
# Recursos Azure Monitor para las gráficas de Administración (opcionales en PostgreSQL externo).
AZURE_POSTGRES_RESOURCE_ID=
AZURE_STORAGE_RESOURCE_ID=
# API Entra de la Function; la identidad llamadora requiere Inventory.Generate.
AZURE_FUNCTION_SCOPE=api://your-api-client-id/.default
AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=cloud-inventory
AZURE_STORAGE_BLOB=azure/latest.json
AZURE_MAX_OBJECT_MB=64

# FinOps: identidad del servidor y suscripciones autorizadas (máx. 20).
# En local, default permite usar la sesión de az login.
# Vacío reutiliza el catálogo de inventario. En Azure se asigna Cost Management Reader a la web.
FINOPS_AUTH_MODE=default
FINOPS_SUBSCRIPTION_IDS=
